# ---- Ethereum RPC (read-only access) ----
# Obtain from Alchemy or Infura. WS for real-time subscriptions, HTTP for backfill.
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ETH_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/web3_threat_monitor

# ---- Microsoft Sentinel (Logs Ingestion API via Data Collection Rule) ----
# Entra ID app registration granted "Monitoring Metrics Publisher" on the DCR.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENTINEL_DCE_ENDPOINT=https://your-dce.region.ingest.monitor.azure.com
SENTINEL_DCR_IMMUTABLE_ID=dcr-xxxxxxxxxxxxxxxxxxxxxxxx
SENTINEL_STREAM_NAME=Custom-Web3Alerts_CL

# ---- Application ----
LOG_LEVEL=INFO
